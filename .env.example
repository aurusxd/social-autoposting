# Веб-панель
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=
# Необязательно: PBKDF2-хеш вместо пароля в открытом виде.
# Сгенерировать: python -m app.core.security
WEB_ADMIN_PASSWORD_HASH=
# Обязательно, не меньше 32 символов.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
WEB_SECRET_KEY=
WEB_SESSION_MAX_AGE=604800
WEB_MAX_UPLOAD_BYTES=2097152000
# true только когда панель открыта по HTTPS
WEB_SECURE_COOKIES=false
# Используются при запуске через `python main.py`, в Compose не нужны
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Только для запуска за чужим реверс-прокси, через compose.proxy.yaml:
# Docker-сеть, в которой работает этот прокси. Список: docker network ls
PROXY_NETWORK=

# Telegram как площадка публикации
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_API_LOCAL=false
TELEGRAM_API_SERVER_FILES_PATH=/var/lib/telegram-bot-api
TELEGRAM_API_CLIENT_FILES_PATH=/var/lib/telegram-bot-api

CELERY_BROKER_URL=redis://localhost:6379/0
DATABASE_URL=
# Как часто beat проверяет отложенные посты, секунды. Задержка публикации
# не превышает этот интервал.
SCHEDULER_INTERVAL_SECONDS=30

WHAPI_API_TOKEN=
WHAPI_API_URL=https://gate.whapi.cloud
WHAPI_REQUEST_TIMEOUT=120
WHAPI_MEDIA_MAX_BYTES=104857600
WHATSAPP_TARGET_LIMIT=50

ZERNIO_API_KEY=
ZERNIO_INSTAGRAM_ACCOUNT_ID=
ZERNIO_TIKTOK_ACCOUNT_ID=
ZERNIO_API_BASE_URL=https://zernio.com/api
ZERNIO_REQUEST_TIMEOUT=120
ZERNIO_TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
